{
  "name": "wattprint",
  "version": "0.1.0",
  "description": "Real-time per-app power and cost monitor for your PC. Local-first, MIT licensed.",
  "main": "out/main/index.js",
  "author": "Richmond Goh <richmondgoh@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "svelte-check --tsconfig ./tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -w better-sqlite3 || echo 'electron-rebuild failed; run npm run rebuild manually'",
    "test:unit": "vitest run --exclude 'tests/store.test.ts' --exclude 'tests/ledger.test.ts'",
    "test:db": "npm rebuild better-sqlite3 --silent && vitest run tests/store.test.ts tests/ledger.test.ts && npm run rebuild",
    "test": "npm run test:unit && npm run test:db",
    "build:win": "node scripts/build-win.mjs",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-store": "^10.0.0",
    "systeminformation": "^5.23.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
